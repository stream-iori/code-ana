<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="orderRepository"
          class="com.example.shop.repository.InMemoryOrderRepository"/>

    <bean id="priceCalculator"
          class="com.example.shop.service.PriceCalculator"/>

    <bean id="orderEventPublisher"
          class="com.example.shop.event.OrderEventPublisher"/>

    <bean id="orderService" class="com.example.shop.service.OrderService">
        <constructor-arg ref="orderRepository"/>
        <property name="eventPublisher" ref="orderEventPublisher"/>
        <property name="priceCalculator" ref="priceCalculator"/>
    </bean>

</beans>
